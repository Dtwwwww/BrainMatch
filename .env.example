# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI — 主模型 DeepSeek（通过 OpenAI 兼容端点）
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key        # 可选：降级模型用
AI_PRIMARY_MODEL=deepseek-chat           # 可选：默认 deepseek-chat
AI_FALLBACK_MODEL=                       # 可选：降级模型名，如 gpt-4o-mini

# OCR — 阿里云百炼（JD 图片 + 简历 PDF 扫描件识别）
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 可选

# Redis 限流（可选，不配置则使用内存限流）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 支付 — mock（开发）| xunhupay（生产虎皮椒）
PAYMENT_PROVIDER=mock
# 虎皮椒（接入真实支付时需配置）
XUNHU_APPID=
XUNHU_SECRET=
XUNHU_API_BASE=https://api.xunhupay.com
XUNHU_NOTIFY_URL=

# 管理员
ADMIN_SECRET_KEY=your-admin-secret-key-change-me

# 微信 OAuth（暂不可用，保留配置项供未来接入）
NEXT_PUBLIC_WECHAT_APPID=
WECHAT_APPSECRET=
