# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Models
AI_PRIMARY_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=deepseek-chat
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx

# WeChat OAuth
NEXT_PUBLIC_WECHAT_APPID=wx_your_appid
WECHAT_APPSECRET=your_app_secret

# Payment（可选值：hupijiao | payjs | alipay_ai | mock）
PAYMENT_PROVIDER=mock

# 虎皮椒支付
HUPIJIAO_APPID=your_hupijiao_appid
HUPIJIAO_SECRET=your_hupijiao_secret

# PayJS
PAYJS_MCHID=your_payjs_mchid
PAYJS_KEY=your_payjs_key

# Alipay AI Receive（推荐，0% 费率）
ALIPAY_APPID=your_alipay_appid
ALIPAY_PRIVATE_KEY=your_alipay_private_key

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Admin
ADMIN_SECRET_KEY=your-random-secret-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
